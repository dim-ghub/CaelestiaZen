[
  {
    "type": "separator",
    "label": "Interface"
  },
  {
    "type": "dropdown",
    "value": "string",
    "property": "caelestia.zen.ui-style",
    "defaultValue": "m3e",
    "label": "Interface style",
    "description": "Restyle Zen's sidebar, URL bar and menus",
    "options": [
      { "label": "M3 Expressive", "value": "m3e" },
      { "label": "Zen default", "value": "zen" }
    ]
  },
  {
    "type": "dropdown",
    "value": "string",
    "property": "caelestia.zen.ui-shape",
    "defaultValue": "expressive",
    "label": "Shape",
    "options": [
      { "label": "Expressive (round, large)", "value": "expressive" },
      { "label": "Standard", "value": "standard" }
    ],
    "conditions": [{ "if": { "property": "caelestia.zen.ui-style", "value": "m3e" } }]
  },
  {
    "type": "dropdown",
    "value": "string",
    "property": "caelestia.zen.ui-density",
    "defaultValue": "comfortable",
    "label": "Density",
    "options": [
      { "label": "Comfortable", "value": "comfortable" },
      { "label": "Compact", "value": "compact" }
    ],
    "conditions": [{ "if": { "property": "caelestia.zen.ui-style", "value": "m3e" } }]
  },
  {
    "type": "checkbox",
    "property": "caelestia.zen.follow-mode",
    "defaultValue": true,
    "label": "Follow Caelestia light/dark",
    "description": "Switch Zen and websites between light and dark with your shell's scheme"
  },
  {
    "type": "separator",
    "label": "Websites"
  },
  {
    "type": "dropdown",
    "value": "string",
    "property": "caelestia.zen.tint",
    "defaultValue": "balanced",
    "label": "Website tint",
    "description": "How strongly every website is recolored to match your scheme",
    "options": [
      { "label": "Off", "value": "off" },
      { "label": "Subtle", "value": "subtle" },
      { "label": "Balanced", "value": "balanced" },
      { "label": "Vivid", "value": "vivid" },
      { "label": "Accent", "value": "accent" },
      { "label": "Custom", "value": "custom" }
    ]
  },
  {
    "type": "dropdown",
    "value": "string",
    "property": "caelestia.zen.tint-color",
    "defaultValue": "surface",
    "label": "Tint color",
    "options": [
      { "label": "Surface", "value": "surface" },
      { "label": "Surface Container", "value": "surfaceContainer" },
      { "label": "Surface Container High", "value": "surfaceContainerHigh" },
      { "label": "Surface Dim", "value": "surfaceDim" },
      { "label": "On Surface", "value": "onSurface" },
      { "label": "Primary", "value": "primary" },
      { "label": "Secondary", "value": "secondary" },
      { "label": "Tertiary", "value": "tertiary" }
    ],
    "conditions": [{ "if": { "property": "caelestia.zen.tint", "value": "custom" } }]
  },
  {
    "type": "string",
    "value": "num",
    "property": "caelestia.zen.tint-intensity",
    "defaultValue": "150",
    "label": "Intensity (0-200)",
    "description": "Higher = more vivid",
    "conditions": [{ "if": { "property": "caelestia.zen.tint", "value": "custom" } }]
  },
  {
    "type": "string",
    "value": "num",
    "property": "caelestia.zen.tint-brightness",
    "defaultValue": "15",
    "label": "Brightness (0-100)",
    "description": "Higher = brighter",
    "conditions": [{ "if": { "property": "caelestia.zen.tint", "value": "custom" } }]
  },
  {
    "type": "string",
    "value": "num",
    "property": "caelestia.zen.tint-strength",
    "defaultValue": "70",
    "label": "Strength (0-100)",
    "description": "Higher = stronger tint",
    "conditions": [{ "if": { "property": "caelestia.zen.tint", "value": "custom" } }]
  },
  {
    "type": "separator",
    "label": "Background"
  },
  {
    "type": "dropdown",
    "value": "string",
    "property": "caelestia.zen.background",
    "defaultValue": "solid",
    "label": "Background",
    "options": [
      { "label": "Caelestia surface", "value": "solid" },
      { "label": "Transparent (needs Transparent Zen mod)", "value": "transparent" }
    ]
  },
  {
    "type": "string",
    "value": "num",
    "property": "caelestia.zen.background-opacity",
    "defaultValue": "80",
    "label": "Opacity (0-100)",
    "description": "Website tint keeps working while Transparent is active",
    "conditions": [{ "if": { "property": "caelestia.zen.background", "value": "transparent" } }]
  }
]
