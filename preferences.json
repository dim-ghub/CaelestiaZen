[
  {
    "type": "separator",
    "label": "CaelestiaZen Settings"
  },
  {
    "type": "string",
    "property": "caelestia.zen-sync.chrome-path",
    "defaultValue": "~/.local/state/caelestia/theme/zen-browser.css",
    "label": "Theme File Path",
    "description": "Path to the zen-browser.css theme file"
  },
  {
    "type": "separator",
    "label": "Transparent Zen Mod"
  },
  {
    "type": "checkbox",
    "property": "caelestia.zen-sync.transparent-zen",
    "defaultValue": false,
    "label": "Enable Transparent Zen",
    "description": "Uses surface color with transparency for background, disables website theming."
  },
  {
    "type": "string",
    "value": "num",
    "property": "caelestia.zen-sync.transparency-level",
    "defaultValue": "80",
    "label": "Transparency Level",
    "description": "Opacity level for background (0-100)"
  },
  {
    "type": "separator",
    "label": "Website Boost"
  },
  {
    "type": "string",
    "value": "num",
    "property": "caelestia.zen-sync.saturation",
    "defaultValue": "150",
    "label": "Color Intensity",
    "description": "0-200 (default: 200 = 2.00)"
  },
  {
    "type": "string",
    "value": "num",
    "property": "caelestia.zen-sync.brightness",
    "defaultValue": "15",
    "label": "Color Brightness",
    "description": "0-100 (default: 5 = 0.05)"
  },
  {
    "type": "string",
    "value": "num",
    "property": "caelestia.zen-sync.contrast",
    "defaultValue": "30",
    "label": "Color Strength",
    "description": "0-100 (default: 50 = 0.50, lower = stronger)"
  }
]